{
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "*.php",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(assets/.*|favicon\\.(?:ico|png)|logo_agencia_selena\\.png|(?:verificador|calculadora)\\.js|animales_guacharito\\.json)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/router.php"
    }
  ]
}

